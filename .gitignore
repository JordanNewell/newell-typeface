# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env
*.whl

# Build artifacts
build/
dist/
*.ufo.zst
master_ufo/
instance_ufo/
instances/

# Derived variable-font master UFOs (regenerated by build_variable.py;
# Newell-Regular.ufo stays committed as the historical source of truth)
sources/Newell-Light.ufo
sources/Newell-Bold.ufo
sources/Newell-Black.ufo

# Generated fonts (committed in /releases/ for distribution)
*.otf
*.ttf
*.woff
*.woff2
!releases/**

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
Thumbs.db

# Logs
*.log
pip-log.txt

# Local screenshot debug output (regenerable via scripts/screenshot.py)
scripts/_preview/home_*.png
scripts/_preview/about*.png
scripts/_preview/try*.png
scripts/_preview/*_full.png
scripts/_preview/*_hero.png

# Browser download artifacts (Chrome appends #1)
releases/*.woff2.*
releases/*#*

# Legibility contact sheet (regenerable via scripts/gen_manifest.py)
scripts/_preview/contact_sheet.png
